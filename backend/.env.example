# Copy this file to `.env` (same folder) and fill in the values.
#   cp .env.example .env
# `.env` is git-ignored — never commit it.

# --- Required for the real agent -------------------------------------------

# OpenAI API key. Drives the agent loop (openai-agents SDK).
# Get it at https://platform.openai.com/api-keys — format: sk-proj-... or sk-...
OPENAI_API_KEY=

# Exa API key. Used by the `verify_entity` tool (company / RUC lookup).
# Get it at https://dashboard.exa.ai/api-keys — format: a UUID-like string.
EXA_API_KEY=

# --- Optional ---------------------------------------------------------------

# Fallback model provider if OpenAI credit runs out mid-event (docs/RIESGOS.md R8).
# Only used when OPENAI_API_KEY is empty. Get it at https://openrouter.ai/keys
# format: sk-or-v1-...
OPENROUTER_API_KEY=

# Leave UNSET for the real agent (the default). Set to "stub" only to run the
# deterministic, network-free agent used to certify tests without a live key.
# Never set it to "stub" for the demo or the video.
# VENTANA_AGENT_BACKEND=stub
